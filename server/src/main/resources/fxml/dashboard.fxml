<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.dau.labmanagement.server.controller.DashboardController" styleClass="app-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-bar">
            <children>
                <Label text="DAU | QUẢN LÝ PHÒNG MÁY" styleClass="brand" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="identityLabel" styleClass="header-caption" />
                <Button fx:id="logoutButton" text="Đăng xuất" onAction="#onLogout" styleClass="header-button" />
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="260" spacing="12" styleClass="side-bar">
            <children>
                <Label fx:id="navigationTitle" text="ĐIỀU HƯỚNG" styleClass="sidebar-title" />
                <VBox fx:id="navigation" spacing="6" VBox.vgrow="ALWAYS" />
                <Label fx:id="roleLabel" wrapText="true" styleClass="sidebar-foot" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="18" styleClass="content-area">
            <children>
                <Label fx:id="pageTitle" styleClass="page-title" />
                <StackPane fx:id="contentOutlet" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
    <bottom>
        <Label fx:id="statusLabel" text="Server · Đã đăng nhập" styleClass="bottom-bar" />
    </bottom>
</BorderPane>
