<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.dau.labmanagement.client.controller.ClientShellController" styleClass="app-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-bar">
            <children>
                <Label text="DAU | MÁY SINH VIÊN" styleClass="brand" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Client · FND-04" styleClass="header-caption" />
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="245" spacing="12" styleClass="side-bar">
            <children>
                <Label text="ĐIỀU HƯỚNG" styleClass="sidebar-title" />
                <Button fx:id="loginNav" text="Đăng nhập" onAction="#showLogin" maxWidth="Infinity" styleClass="nav-button" />
                <Button fx:id="homeNav" text="Trang chính" onAction="#showHome" maxWidth="Infinity" styleClass="nav-button" />
                <Region VBox.vgrow="ALWAYS" />
                <Label text="Vai trò: Sinh viên" styleClass="sidebar-foot" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="18" styleClass="content-area">
            <children>
                <Label fx:id="pageTitle" styleClass="page-title" />
                <StackPane fx:id="contentOutlet" alignment="TOP_CENTER" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
    <bottom><Label fx:id="clientStatus" text="Client · Chưa kết nối Server (minh họa)" styleClass="bottom-bar" /></bottom>
</BorderPane>